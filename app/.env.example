# Malitan 3D - environment variables read by the app (all in config/settings.py).
#
# Usage:
#   local dev: cp .env.example .env.local   (set ENV=development)
#   docker:    docker run --env-file .env ...
#   Helm:      [secret] -> Secret, [config] -> ConfigMap
#
# Commented-out lines show the default. Leave them commented to keep the default:
# with --env-file, "VAR=" sets an EMPTY value, which is not the same as unset.
# Comments must stay on their own line (docker does not strip trailing comments).

# ---------------------------------------------------------------- Required

# [config] "production" (default) or "development" (dev-only key, dev passwords, SQL echo, debugger).
ENV=production

# [secret] Signs session cookies. Required outside development, at least 32 random characters.
AUTH_SECRET_KEY=

# ---------------------------------------------------------------- Storage

# [config] Writable directory for the SQLite file and product images (mount a volume here).
# DATA_DIR=<app dir>/data

# [config] Read but currently unused by the app.
# EXPORTS_DIR=<app dir>/exports

# [config] Read but currently unused by the app.
# BACKUPS_DIR=<app dir>/backups

# ---------------------------------------------------------------- Database

# [config] "sqlite" (default); any other value uses the PostgreSQL engine settings.
# DATABASE_TYPE=sqlite

# [secret] SQLAlchemy URL. PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/<db>
# DATABASE_URL=sqlite:///<DATA_DIR>/malitan.db

# ---------------------------------------------------------------- HTTP

# [config] Session cookie only sent over HTTPS. Set to false only for plain-HTTP local use.
# SESSION_COOKIE_SECURE=true

# [secret] Bearer token enabling GET /api/status; disabled when empty or under 32 characters.
# STATUS_API_TOKEN=

# ---------------------------------------------------------------- Notifications (empty = disabled)

# [secret] Brevo API key; enables customer emails.
# BREVO_API_KEY=

# [config] Sender address for Brevo emails (default: the studio address in config/settings.py).
# BREVO_SENDER_EMAIL=sender@example.com

# [config] Sender name for Brevo emails.
# BREVO_SENDER_NAME=Malitan Studio

# [config] "true" emails customers when an order is ready for delivery (needs BREVO_API_KEY).
# ENABLE_PACKAGING_EMAILS=false

# [secret] BulkGate application ID; SMS needs both BulkGate values.
# BULKGATE_APPLICATION_ID=

# [secret] BulkGate application token.
# BULKGATE_APPLICATION_TOKEN=

# [secret] Telegram bot token for internal notifications to David and Lea.
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- App metadata

# [config] Name shown in the UI.
# APP_NAME=Malitan 3D Manager

# [config] Version shown in the UI; keep in sync with pyproject.toml.
# APP_VERSION=2.11.4

# [config] Read but currently unused by the app.
# SHOW_PERFORMANCE_TIMING=false

# ---------------------------------------------------------------- Development only (ENV=development)

# [secret] Password given to david by "flask init-db" in development.
# DEV_PASS_DAVID=dev123

# [secret] Password given to lea by "flask init-db" in development.
# DEV_PASS_LEA=dev123

# [secret] Password given to danielle by "flask init-db" in development.
# DEV_PASS_DANIELLE=dev123
